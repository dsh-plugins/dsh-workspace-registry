{
  "name": "@dsh-prism/dsh-workspace-registry",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/*.test.*",
    "!dist/*.tsbuildinfo",
    "!dist/*probe.*",
    "locale/*.json",
    "icon.svg",
    "README.zh_CN.md"
  ],
  "engines": {
    "node": ">=24.0.0",
    "dsh": "0.2.3-alpha.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1"
  },
  "scripts": {
    "build": "tsc -b"
  }
}
